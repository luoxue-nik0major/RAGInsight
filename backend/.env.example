# RAGInsight 环境配置模板
# 复制此文件为 .env 并填入你的实际值

# 运行环境: development | test | production
RAGINSIGHT_ENVIRONMENT=development

# DeepSeek API 配置（必须）
RAGINSIGHT_DEEPSEEK_API_KEY=sk-your-api-key-here
RAGINSIGHT_DEEPSEEK_BASE_URL=https://api.deepseek.com
RAGINSIGHT_DEEPSEEK_MODEL=deepseek-v4-flash

# 数据库
RAGINSIGHT_DATABASE_URL=sqlite+aiosqlite:///./raginsight.db

# ChromaDB 向量存储路径
RAGINSIGHT_CHROMA_DB_PATH=./chroma_db
RAGINSIGHT_CHROMA_DB_TEST_PATH=./chroma_db_test

# Embedding 模型
RAGINSIGHT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# Embedding 模型缓存目录（可选，默认使用 HuggingFace 缓存目录）
# RAGINSIGHT_EMBEDDING_CACHE_DIR=/path/to/embedding_cache
# 离线模式：true 时禁止下载模型（要求模型已在缓存目录中）
# RAGINSIGHT_EMBEDDING_LOCAL_ONLY=false

# 缓存配置（秒）
RAGINSIGHT_RETRIEVAL_CACHE_TTL=300
RAGINSIGHT_ANSWER_CACHE_TTL=600
RAGINSIGHT_EMBEDDING_CACHE_SIZE=1000
